#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <220>; };

&mt { quick_tap_ms = <220>; };

/ {
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE  &kp W          &kp E      &kp R           &kp T      &kp Y      &kp U            &kp I      &kp O     &kp BACKSPACE
&kp Q       &kp S          &kp D      &kp F           &kp G      &kp H      &kp J            &kp K      &kp L     &kp P
&kp A       &kp X          &kp C      &kp V           &kp B      &kp N      &kp M            &kp COMMA  &kp UP    &kp SLASH
&kp Z       &kp RIGHT_ALT  &kp ENTER  &kp LEFT_SHIFT  &kp SPACE  &kp SPACE  &kp RIGHT_SHIFT  &kp LEFT   &kp DOWN  &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&kp TILDE        &kp N2       &kp N3    &kp N4      &kp N5       &kp N6     &kp N7         &kp N8        &kp N9                &kp DEL
&kp N1           &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp N0
&kp EXCLAMATION  &trans       &trans    &trans      &trans       &trans     &trans         &trans        &trans                &kp RIGHT_PARENTHESIS
&trans           &trans       &trans    &trans      &trans       &trans     &trans         &trans        &trans                &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
